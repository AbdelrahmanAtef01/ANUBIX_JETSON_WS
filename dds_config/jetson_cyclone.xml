<!--
  CycloneDDS configuration for the Jetson Orin Nano.

  Single autodetermine interface — Cyclone picks whichever NIC is up.
  This avoids crashes when the RPi direct-ethernet link (192.168.10.1)
  is not configured: previous configs that pinned to that address or
  combined it with loopback caused either "interface not found" aborts
  or "same interface selected twice" errors.

  The RPi peer (192.168.10.2) stays in Discovery/Peers so cross-machine
  DDS traffic flows as soon as that link comes up — but if it never
  does, nothing crashes.

  Network topology:
    Jetson  enp8p1s0  192.168.10.1/24  (RPi link, optional at boot)
                      192.168.0.100/24 (arm link)
    RPi               192.168.10.2/24  (peer, may be absent)
    Arm               192.168.0.232    (TCP, not DDS)
-->
<CycloneDDS>
  <Domain id="any">

    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="localhost"/>
        <Peer address="192.168.10.2"/>
      </Peers>
    </Discovery>

    <Tracing>
      <Verbosity>severe</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>

  </Domain>
</CycloneDDS>
