<!--
  CycloneDDS configuration for the Jetson Orin Nano.

  Goals:
    (a) Local participant discovery between separate ROS terminals on
        this Jetson always works, even when the direct-ethernet link
        to the RPi is not yet configured (no 192.168.10.1 interface).
    (b) Cross-machine discovery to the RPi works over the direct
        ethernet link once 192.168.10.1 is up.

  Why this shape:
    Previous revisions tried to pin the interface to a hardcoded name
    ("eth0") or hardcoded address (192.168.10.1). Both are fragile —
    if the kernel renames the USB-Ethernet adapter, or if the user
    boots the Jetson without the RPi cable, Cyclone has nothing to
    bind and falls back to undefined behavior. Symptom: `ros2 node
    list` and `ros2 topic list` return empty even though every node
    is running fine inside the launch.

    Now: we declare the direct-link IP as a "best-effort" interface
    (presence_required=false → Cyclone does NOT fail if it is missing),
    AND we let Cyclone autodetect the system default so there is
    always at least one usable interface for local discovery.

  Network topology:
    Jetson IP  192.168.10.1 / 24  (this machine; optional at boot)
    RPi    IP  192.168.10.2 / 24  (peer)
-->
<CycloneDDS>
  <Domain id="any">

    <General>
      <Interfaces>
        <!--
          Preferred interface: the direct ethernet link to the RPi.
          presence_required="false" means Cyclone WILL NOT abort if
          192.168.10.1 is not configured on any interface — it just
          uses the autodetected one below. This is what makes local
          discovery survive a boot without the RPi cable.
        -->
        <NetworkInterface address="192.168.10.1" presence_required="false" priority="10"/>
        <!--
          Fallback: pick the system default interface (usually built-in
          ethernet or Wi-Fi). Guarantees local discovery always has a
          working transport even before the direct link is up.
        -->
        <NetworkInterface autodetermine="true" priority="0"/>
      </Interfaces>
      <!--
        SPDP = multicast for the small Simple Participant Discovery
        Protocol packets only; bulk data still flows unicast. The
        minimum needed for local-process discovery without flooding
        the direct ethernet link with heavy multicast traffic.
      -->
      <AllowMulticast>spdp</AllowMulticast>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
      <Peers>
        <!--
          localhost: belt-and-suspenders for cross-terminal discovery
          on this Jetson, in case multicast SPDP is blocked on lo for
          any reason. Without this, topics from local launches can
          randomly disappear from `ros2 topic list`.
        -->
        <Peer address="localhost"/>
        <!-- Raspberry Pi over the direct ethernet link -->
        <Peer address="192.168.10.2"/>
      </Peers>
    </Discovery>

    <Tracing>
      <!-- Set to "config" or "finest" for deep DDS debugging -->
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>

  </Domain>
</CycloneDDS>
