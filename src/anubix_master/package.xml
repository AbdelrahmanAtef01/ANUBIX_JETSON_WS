<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>anubix_master</name>
  <version>1.0.0</version>
  <description>ANUBIX ROS 2 Master Node - bridges OmniLink AI agent to the 4-stack robot architecture</description>
  <maintainer email="anubix@example.com">ANUBIX Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>python3-omnilink</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
